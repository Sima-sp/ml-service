# Copie para .env e ajuste. O .env real NUNCA é versionado.

# --- Serviço de IA (lido por app/configuracao.py) ---
VERSAO_MODELO=v1
DIR_MODELOS=models
PORTA=5000
LOG_LEVEL=INFO

# Validade da previsão devolvida em "validaAte" (minutos)
VALIDADE_PREVISAO_MIN=30
# Por quanto tempo a chuva baixada do Open-Meteo é reutilizada sem nova chamada (minutos)
CACHE_CHUVA_TTL_MIN=15
# Idade máxima da "última chuva conhecida" usada quando o Open-Meteo falha (minutos)
IDADE_MAX_CHUVA_MIN=60
# Timeout das chamadas ao Open-Meteo (segundos)
TIMEOUT_OPEN_METEO_S=5
# Distância máxima (m) para considerar que o sensor está sobre um ponto conhecido da base
RAIO_PONTO_CONHECIDO_M=500
# true => devolve "MÉDIO"/"CRÍTICO" com acento; false => "MEDIO"/"CRITICO" (recomendado, igual ao enum Java)
NIVEL_RISCO_COM_ACENTO=false

# --- Coleta de dados (lido por src/collect/http.py) ---
# E-mail de contato no User-Agent: exigido pela política de uso do Nominatim.
CONTATO_EMAIL=seu-email@exemplo.com
# Pausa mínima entre requisições ao site do CGE (segundos)
PAUSA_CGE_S=1.5
